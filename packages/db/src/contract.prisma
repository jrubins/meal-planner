// use prisma-8

// Data contract: the source of truth for the database schema.
// After editing: `pnpm --filter @app/db emit`, then `pnpm --filter @app/db migration:plan`.
//
// Data belongs to a household (the people who plan dinners together), not to one user. Every
// user is a member of exactly one household; services resolve it from the acting user's ID and
// filter every query by it.

model Household {
  id           Int                @id @default(autoincrement())
  name         String
  // Shared with a partner so they can join this household.
  inviteCode   String             @unique
  // IANA time zone: decides what "today" and "this week" mean for chat assistants.
  timeZone     String             @default("UTC")
  // 0 = weeks start on Sunday, 1 = Monday.
  weekStartsOn Int                @default(1)
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
  members      HouseholdMember[]
  meals        Meal[]
}

model HouseholdMember {
  id          Int       @id @default(autoincrement())
  // The authenticated user's ID (WorkOS `sub`). A user belongs to one household.
  userId      String    @unique
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  displayName String?
  createdAt   DateTime  @default(now()) @onCreate(now())

  @@index([householdId])
}

model Meal {
  id              Int                @id @default(autoincrement())
  householdId     Int
  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  recipeUrl       String?
  // The recipe, structured (title, servings, ingredients, steps, notes): read from recipe
  // photos or typed in. Validated by RecipeSchema in @app/shared, so its shape can grow
  // without a migration.
  recipe          Json?
  // Before structured recipes: plain text. Read as the recipe's notes until the meal is
  // next saved, which moves it into recipe. Drop once no row has it.
  recipeText      String?
  tags            String[]
  createdByUserId String
  createdAt       DateTime           @default(now()) @onCreate(now())
  updatedAt       temporal.UpdatedAt
  photos          MealPhoto[]
  dinners         Dinner[]
  options         DinnerOption[]

  @@index([householdId, createdAt])
}

model MealPhoto {
  id          Int      @id @default(autoincrement())
  mealId      Int
  meal        Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  householdId Int
  // "meal" (a photo of the dish) or "recipe" (a photo of the recipe, read into text).
  kind        String   @default("meal")
  // Recipe photos only: "reading", "done", "not_a_recipe", "failed" or "unavailable".
  readStatus  String?
  // Meal photos only: true when an AI image model made it from the meal's details.
  generated   Boolean  @default(false)
  contentType String
  data        Bytes
  createdAt   DateTime @default(now()) @onCreate(now())

  @@index([mealId, createdAt])
}

// The dinner chosen for one night: a meal, a note ("eating out"), or both.
model Dinner {
  id              Int                @id @default(autoincrement())
  householdId     Int
  date            Date
  mealId          Int?
  meal            Meal?              @relation(fields: [mealId], references: [id], onDelete: SetNull)
  note            String?
  updatedByUserId String
  createdAt       DateTime           @default(now()) @onCreate(now())
  updatedAt       temporal.UpdatedAt

  @@unique([householdId, date])
}

// A meal proposed for a night, for the household to vote on.
model DinnerOption {
  id               Int          @id @default(autoincrement())
  householdId      Int
  date             Date
  mealId           Int
  meal             Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  proposedByUserId String
  createdAt        DateTime     @default(now()) @onCreate(now())
  votes            OptionVote[]

  @@unique([householdId, date, mealId])
}

model OptionVote {
  id        Int                @id @default(autoincrement())
  optionId  Int
  option    DinnerOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  // "up" or "down".
  value     String
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([optionId, userId])
}
